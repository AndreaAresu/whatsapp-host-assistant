# Chiave API Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modello (default: Claude Haiku 4.5)
MODEL=claude-haiku-4-5-20251001

# Modalità rodaggio: true = OGNI risposta passa da te come bozza.
# Mettila a false quando ti fidi e vuoi l'invio automatico delle risposte sicure.
REVIEW_EVERYTHING=true

# Bot Telegram di controllo — crea un bot con @BotFather e incolla qui il token.
TELEGRAM_BOT_TOKEN=
# Il tuo chat id: avvia l'harness, scrivi /start al bot e te lo dirà lui.
TELEGRAM_CHAT_ID=
