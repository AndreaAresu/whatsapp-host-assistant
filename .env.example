# Chiave API Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modello (default: Claude Haiku 4.5)
MODEL=claude-haiku-4-5-20251001

# Modalità rodaggio: true = OGNI risposta passa da te come bozza.
# Mettila a false quando ti fidi e vuoi l'invio automatico delle risposte sicure.
REVIEW_EVERYTHING=true

# Bot Telegram di controllo — crea un bot con @BotFather e incolla qui il token.
TELEGRAM_BOT_TOKEN=
# Il tuo chat id: avvia l'harness, scrivi /start al bot e te lo dirà lui.
TELEGRAM_CHAT_ID=

# Trascrizione dei messaggi vocali — https://aistudio.google.com/apikey
# Serve perché l'API di Claude non accetta audio in ingresso: Gemini fa solo da
# trascrittore (audio -> testo), poi risponde Claude come per un messaggio normale.
# Se la lasci vuota, i vocali continuano ad arrivarti come semplice notifica.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Solo per la DEMO WEB (vedi DEMO.md) ---
# Base di conoscenza alternativa. Serve alla demo pubblica, che NON deve usare
# knowledge/casa.md: quella contiene il codice della key-box e l'indirizzo esatto
# di una casa vera, e la demo risponde a chiunque senza un host che approvi.
# Lasciala vuota per il bot WhatsApp: userà il file vero.
CASA_PATH=

# Ricerca web nella demo. Su Netlify free mettila a "off": con la ricerca attiva
# un vocale arriva a 8,6s contro il tetto di 10s delle funzioni sincrone.
DEMO_WEB_SEARCH=
# Messaggi concessi a ogni visitatore, e finestra in minuti. È il tetto di spesa
# principale della demo: senza, un solo visitatore può bruciare i crediti.
LIMITE_MESSAGGI=15
FINESTRA_MINUTI=60
